# Βάλε αυτές τις τιμές στο Vercel: Project → Settings → Environment Variables.

# Για τη φόρμα «Κλείσε παρουσίαση» (τα αιτήματα γράφονται στη βάση της VGS)
NEXT_PUBLIC_SUPABASE_URL=
# ΜΥΣΤΙΚΟ: μόνο στο Vercel, ποτέ με NEXT_PUBLIC_ μπροστά.
SUPABASE_SERVICE_ROLE_KEY=

# Προαιρετικά
# Η διεύθυνση αυτής της σελίδας, π.χ. https://vgs-selida.vercel.app
NEXT_PUBLIC_SITE_URL=
# Όταν ανέβει το demo του Πακέτου 2, π.χ. https://vgs22.vercel.app/alexi
NEXT_PUBLIC_DEMO_AUTOPILOT_URL=
